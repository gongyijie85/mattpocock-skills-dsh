{
  "name": "mattpocock-skills-dsh",
  "description": "Matt Pocock's skills for the DeepSeek Harness: grilling, writing-for-agents, wait-what and more — adapted from https://github.com/mattpocock/skills",
  "version": "0.1.7",
  "private": false,
  "type": "module",
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongyijie85/mattpocock-skills-dsh.git"
  },
  "homepage": "https://github.com/gongyijie85/mattpocock-skills-dsh",
  "bugs": {
    "url": "https://github.com/gongyijie85/mattpocock-skills-dsh/issues"
  },
  "scripts": {
    "verify": "node scripts/verify-provider.mjs",
    "prepublishOnly": "node scripts/verify-provider.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skills",
    "mattpocock",
    "aihero"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.0.1-rc.1": "incompatible",
        "0.0.1-rc.2": "incompatible",
        "0.0.1-rc.5": "incompatible",
        "0.1.0-rc.2": "incompatible",
        "0.1.0-rc.3": "incompatible",
        "0.1.0-rc.6": "compatible",
        "0.1.0-rc.7": "compatible",
        "0.1.0-rc.8": "compatible",
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.2": "compatible",
        "0.1.2-alpha.3": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.2": "compatible",
        "0.1.5-alpha.1": "compatible",
        "0.1.5-alpha.2": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      }
    }
  }
}
